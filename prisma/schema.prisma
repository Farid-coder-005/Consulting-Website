datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user")
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  message   String
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])
  createdAt DateTime @default(now())

  @@map("contacts")
}

model Location {
  id        String   @id @default(cuid())
  country   String
  city      String
  address   String
  phone     String
  email     String   @unique
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]

  @@map("locations")
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  isActive    Boolean  @default(true)
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts Contact[]

  @@map("services")
}

model Post {
  id          String   @id @default(cuid())
  title       String
  content     String
  excerpt     String?
  coverImage  String?
  published   Boolean  @default(false)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("posts")
}
